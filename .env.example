# Base URL includes /v1 where required; do not include /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-name
LLM_API_KEY=replace-me
# Optional: true sends rendered question images, false uses local OCR.
# Official api.deepseek.com + deepseek-flash enables vision automatically.
# LLM_VISION=true
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRIDGE_TOKEN=replace-with-a-random-token-at-least-24-characters
